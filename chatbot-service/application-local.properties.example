# =============================================================================
# Plantilla de Configuracion Local para chatbot-service
# Copia este archivo como 'application-local.properties' para desarrollo local.
# Este archivo esta en .gitignore y no debe subirse al repositorio.
# =============================================================================

# Google Gemini API (Obligatoria: falla al iniciar si no esta configurada)
GEMINI_API_KEY=

# Seguridad del Servicio (Obligatoria: validada en el header X-API-Key)
SERVICE_API_KEY=

# Modelos de Gemini
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
EMBEDDING_DIM=1536

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/hydrogest
DB_USER=postgres
DB_PASSWORD=

# CORS: origenes permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Limites de POST /chat por ventana de un minuto
RATE_LIMIT_PER_SESSION=10
RATE_LIMIT_PER_IP=30

# Parametros RAG y Base de Conocimiento
RAG_TOP_K=4
UMBRAL_SIMILITUD=0.65
CONOCIMIENTO_DIR=conocimiento
